{
  "manifest_version": 3,
  "name": "VideoVault 自動填入",
  "version": "1.0.0",
  "description": "本地下載站開啟 fdown / saveclip / threadsdownloader 時，自動把影片網址填進輸入框。",
  "content_scripts": [
    {
      "matches": [
        "https://fdown.net/*",
        "https://saveclip.app/*",
        "https://www.threadsdownloader.com/*",
        "https://threadsdownloader.com/*"
      ],
      "js": ["fill.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
      "js": ["marker.js"],
      "run_at": "document_start"
    }
  ]
}
